<xs:schema version="1.0"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:dtwoms="http://www.powsybl.org/schema/iidm/ext/dynawo_two_level_overload_management_system_model/1_0"
           targetNamespace="http://www.powsybl.org/schema/iidm/ext/dynawo_two_level_overload_management_system_model/1_0"
           elementFormDefault="qualified">

    <xs:simpleType name="TwoSides">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ONE"/>
            <xs:enumeration value="TWO"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="dynawoTwoLevelOverloadManagementSystemModel">
        <xs:complexType>
            <xs:attribute name="dynamicModelId" use="required" type="xs:string"/>
            <xs:attribute name="modelName" use="required" type="xs:string"/>
            <xs:attribute name="parameterSetId" type="xs:string"/>
            <xs:attribute name="iMeasurement1" use="required" type="xs:string"/>
            <xs:attribute name="iMeasurement1Side" use="required" type="dtwoms:TwoSides"/>
            <xs:attribute name="iMeasurement2" use="required" type="xs:string"/>
            <xs:attribute name="iMeasurement2Side" use="required" type="dtwoms:TwoSides"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
